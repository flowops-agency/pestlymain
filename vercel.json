{
  "version": 2,
  "builds": [
    {
      "src": "server.ts",
      "use": "@vercel/node"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server.ts"
    },
    {
      "src": "/us",
      "dest": "/public/us.html"
    },
    {
      "src": "/datenschutz",
      "dest": "/public/datenschutz.html"
    },
    {
      "src": "/impressum",
      "dest": "/public/impressum.html"
    },
    {
      "src": "/privacy",
      "dest": "/public/privacy.html"
    },
    {
      "src": "/legal",
      "dest": "/public/legal.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
